<?xml version="1.0"?>
<domain type="kvm">
  <name>fixture-multiple</name>
  <memoryBacking><hugepages><page size="1" unit="GiB"/></hugepages></memoryBacking>
  <memoryBacking><hugepages><page size="2" unit="MiB"/></hugepages></memoryBacking>
  <os><type>hvm</type><nvram>/var/lib/libvirt/qemu/nvram/fixture-a.fd</nvram><nvram>/var/lib/libvirt/qemu/nvram/fixture-b.fd</nvram></os>
  <cpu mode="host-passthrough"><topology sockets="1" cores="2" threads="2"/></cpu>
  <cpu mode="custom"><model>fixture</model></cpu>
  <devices>
    <disk type="file" device="disk"><driver name="qemu" type="qcow2"/><source file="/vm/fixture.qcow2"/><target dev="vda"/></disk>
    <disk type="file" device="disk"><driver name="qemu" type="qcow2" discard="unmap"/><source file="/vm/fixture.qcow2"/><target dev="vdc"/></disk>
    <disk type="block" device="disk"><driver name="qemu" type="raw"/><source dev="/dev/disk/by-id/fixture-disk"/><target dev="vdb"/></disk>
    <disk type="block" device="disk"><driver name="qemu" type="raw" discard="unmap"/><source dev="/dev/disk/by-id/fixture-disk"/><target dev="vdd"/></disk>
    <interface type="network"><mac address="52:54:00:12:34:56"/><source network="default"/></interface>
    <interface type="bridge"><mac address="52:54:00:12:34:56"/><source bridge="br0"/></interface>
    <hostdev mode="subsystem" type="pci" managed="yes"><source><address domain="0x0000" bus="0x0a" slot="0x00" function="0x0"/></source></hostdev>
    <hostdev mode="subsystem" type="pci" managed="no"><source><address domain="0x0000" bus="0x0a" slot="0x00" function="0x0"/></source></hostdev>
    <hostdev mode="subsystem" type="pci" managed="yes"><source><address domain="0x0000" bus="0x0a" slot="0x00" function="0x1"/></source></hostdev>
    <hostdev mode="subsystem" type="pci" managed="no"><source><address domain="0x0000" bus="0x0a" slot="0x00" function="0x1"/></source></hostdev>
    <tpm model="tpm-crb"><backend type="emulator" version="2.0"/></tpm>
    <tpm model="tpm-tis"><backend type="emulator" version="2.0"/></tpm>
    <graphics type="spice"/><graphics type="vnc"/>
    <video><model type="qxl"/></video><video><model type="virtio"/></video>
  </devices>
</domain>
